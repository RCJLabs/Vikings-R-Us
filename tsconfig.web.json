{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@platform": ["./packages/platform/src/adapters/web.ts"]
    }
  },
  "include": ["packages/ui/src", "packages/platform/src", "packages/art/src", "apps/web/src"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
